DB_HOST=mariadb
DB_PORT=3316
DB_USER=user
DB_PASSWORD=change-me
DB_NAME=app
DB_POOL_SIZE=10
DB_ROOT_PASSWORD=change-me
API_KEY=change-me
ADMIN_BASIC_USER=admin
ADMIN_BASIC_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-session-secret
CORS_ORIGINS=http://localhost:3001
API_URL=http://api:3000
NEXT_PUBLIC_API_URL=http://localhost:3010
STORAGE_DIR=/app/images
SEED_PHOTOS_SOURCE_DIR=.ai/pictures_seed
I18N_LANGUAGES=es,en
I18N_DEFAULT_LANGUAGE=es
I18N_CONTENT_BASE_LANGUAGE=en

# OpenAI API key for GPT-4 and image generation
OPENAI_API_KEY=sk-proj-...

# OpenAI image generation model (gpt-image-1.5, gpt-image-1, gpt-image-1-mini, dall-e-3, dall-e-2)
IMAGE_MODEL=gpt-image-1.5

# Brave Search API key for research
BRAVE_SEARCH_API_KEY=BSA...

# OSRM routing service for land pathfinding
OSRM_BASE_URL=http://osrm:5000
OSRM_TIMEOUT_MS=5000
OSRM_PBF_URL=https://download.geofabrik.de/europe/spain-latest.osm.pbf
OSRM_PBF_FILE=spain-latest.osm.pbf

# Overpass service endpoint and timeout
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_MS=5000

# Eastward route planner controls
ROUTE_EAST_BEARING_MIN=65
ROUTE_EAST_BEARING_MAX=115
ROUTE_LANDFALL_SAMPLE_KM=25
ROUTE_LANDFALL_MAX_KM=1500

# Geo provider resilience (retry/backoff/circuit breaker + cache)
GEO_RETRY_MAX_ATTEMPTS=3
GEO_RETRY_BASE_DELAY_MS=200
GEO_RETRY_MAX_DELAY_MS=2000
GEO_CIRCUIT_FAILURE_THRESHOLD=5
GEO_CIRCUIT_OPEN_MS=120000
GEO_CACHE_MAX_ENTRIES=2000
GEO_CACHE_TTL_MS_WATER=86400000
GEO_CACHE_TTL_MS_CITY=21600000
GEO_CACHE_TTL_MS_ROUTE=3600000
